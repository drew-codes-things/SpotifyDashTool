{
  "name": "spotify-sort-tool-backend",
  "version": "1.0.0",
  "description": "Express backend + MCP bridge for SpotifySortTool",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build:css": "tailwindcss -c ../tailwind.config.js -i ../css/input.css -o ../public/tailwind.css --minify",
    "watch:css": "tailwindcss -c ../tailwind.config.js -i ../css/input.css -o ../public/tailwind.css --watch"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "tailwindcss": "^3.4.17"
  }
}
